{
  "name": "trllo_api",
  "version": "1.0.0",
  "description": "Trello GQL Server",
  "main": "server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:gql-types": "npx graphql-codegen --config codegen.ts",
    "dev": "npm run build:gql-types && nodemon",
    "clear-dist": "rmdir /s /q dist",
    "build": "npm run clear-dist && tsc && npm run copy:gql",
    "start": "npm run build && node -r tsconfig-paths/register dist/server.js",
	"copy:gql": "copyfiles -u 1 \"src/**/*.gql\" dist"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/mongodb-memory-server": "^1.8.0",
    "@types/node": "^22.15.3",
    "@types/semver": "^7.7.0",
    "@types/validator": "^13.15.0",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "dependencies": {
    "@apollo/server": "^4.12.0",
    "@graphql-tools/load-files": "^7.0.1",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "mongoose": "^8.14.0",
    "validator": "^13.15.0",
    "zod": "^3.24.3"
  }
}
